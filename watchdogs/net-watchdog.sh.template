#!/bin/bash
# Generated by the architect2 kiosk installer -- __INSTALL_DATE__
#
# Dual-network-aware network watchdog. Replaces versions/v9's pi-watchdog.sh,
# which assumed exactly one "the" WiFi interface (a real, confirmed bug:
# nmcli device status filters by TYPE=wifi only, not by connection STATE, so
# a present-but-unused wlan0 got treated as "the" interface even on an
# Ethernet-primary device -- confirmed live on a bench device
# which runs Ethernet AND WiFi at the same time).
#
# DESIGN: this script does not assume a single primary interface. Every
# cycle it discovers whichever interfaces are actually relevant on THIS
# device (eth0 if present, the wifi interface if a wifi connection profile
# is configured -- possibly both), health-checks each independently, and
# only escalates toward a reboot if NONE of them have a working path to the
# internet. WiFi-specific recovery levers (nmcli reconnect, USB dongle
# rebind) only ever act on the wifi interface; Ethernet gets its own,
# simpler ladder. A device that's fine on Ethernet but has a flaky/unused
# WiFi radio should NOT reboot itself over the WiFi radio alone.

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/bin:/usr/bin"

MODE="active"
DASHBOARD_HOST="__DASHBOARD_HOST__"
USB_VID="__USB_VID__"
USB_PID="__USB_PID__"

STATE_DIR="/var/lib/kiosk-net-watchdog"
TRENDLOG="/var/log/kiosk-net-watchdog.log"
WIFI_SCAN_LOG="/var/log/kiosk-wifi-scan.log"
ALERTS_LOG="/var/log/kiosk-net-watchdog-alerts.log"
INCIDENT_DIR="/var/log/kiosk-net-watchdog-incidents"
FAILCOUNT_FILE="$STATE_DIR/fail-count"
LASTSTATE_FILE="$STATE_DIR/last-state"
LASTHEARTBEAT_FILE="$STATE_DIR/last-heartbeat"
NMRESTART_FILE="$STATE_DIR/last-nm-restart"
REBOOT_LOG="$STATE_DIR/reboot-times"
HELD_FILE="$STATE_DIR/held"
TAMPER_REBOOT_MARKER="/var/lib/kiosk-tamper/expected-reboot"

TREND_TRIM_AT=20000
TREND_TRIM_TO=15000
SCAN_LOG_TRIM_AT=4000
SCAN_LOG_TRIM_TO=3000
ALERTS_LOG_TRIM_AT=2000
ALERTS_LOG_TRIM_TO=1500
INCIDENT_RETENTION_DAYS=14
MAX_REBOOTS=3
REBOOT_WINDOW=21600
NM_RESTART_MIN_GAP=600
HEARTBEAT_GAP=3600
CMD_TIMEOUT=20

sudo mkdir -p "$STATE_DIR" "$INCIDENT_DIR" "$(dirname "$TAMPER_REBOOT_MARKER")"
sudo chown pi:pi "$STATE_DIR" "$INCIDENT_DIR" "$(dirname "$TAMPER_REBOOT_MARKER")"
sudo touch "$TRENDLOG" "$WIFI_SCAN_LOG" "$ALERTS_LOG"
sudo chown pi:pi "$TRENDLOG" "$WIFI_SCAN_LOG" "$ALERTS_LOG"
touch "$FAILCOUNT_FILE" "$REBOOT_LOG"

now() { date +%s; }
ts() { date '+%Y-%m-%d %H:%M:%S'; }
log() { echo "$(ts) $1" >> "$TRENDLOG"; }
alert() { echo "$(ts) $1" >> "$ALERTS_LOG"; trim_log "$ALERTS_LOG" "$ALERTS_LOG_TRIM_AT" "$ALERTS_LOG_TRIM_TO"; }

age_of() {
    local f="$1" t
    [ -f "$f" ] || { echo 999999; return; }
    t=$(cat "$f" 2>/dev/null)
    case "$t" in ''|*[!0-9]*) echo 999999; return ;; esac
    echo $(( $(now) - t ))
}

trim_log() {
    local file="${1:-$TRENDLOG}" trim_at="${2:-$TREND_TRIM_AT}" trim_to="${3:-$TREND_TRIM_TO}"
    [ -f "$file" ] || return 0
    local n trimmed
    n=$(wc -l < "$file")
    if [ "$n" -gt "$trim_at" ]; then
        trimmed=$(tail -n "$trim_to" "$file")
        printf '%s\n' "$trimmed" > "$file"
    fi
}

cleanup_old_incidents() {
    find "$INCIDENT_DIR" -maxdepth 1 -mindepth 1 -type d -mtime "+$INCIDENT_RETENTION_DAYS" -exec rm -rf {} \; 2>/dev/null
}

# --- discover what's actually relevant on THIS device, every cycle ---
# (not cached -- a dongle can be unplugged, a cable can be pulled)
discover_eth_if() {
    timeout "$CMD_TIMEOUT" nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="ethernet"{print $1; exit}'
}
discover_wifi_if() {
    timeout "$CMD_TIMEOUT" nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}'
}
wifi_has_profile() {
    local wifi_if="$1"
    [ -n "$wifi_if" ] || return 1
    timeout "$CMD_TIMEOUT" nmcli -t -f NAME,TYPE connection show 2>/dev/null | awk -F: '$2=="802-11-wireless" || $2=="wifi"{found=1} END{exit !found}'
}

get_conn_name_wifi() {
    timeout "$CMD_TIMEOUT" nmcli -t -f NAME,TYPE connection show 2>/dev/null | awk -F: '$2=="802-11-wireless" || $2=="wifi"{print $1; exit}'
}
get_conn_name_eth() {
    timeout "$CMD_TIMEOUT" nmcli -t -f NAME,TYPE connection show 2>/dev/null | awk -F: '$2=="802-3-ethernet" || $2=="ethernet"{print $1; exit}'
}

bring_up() {
    local conn="$1"
    [ -n "$conn" ] || { log "  -> no connection profile found to bring up"; return 1; }
    log "  -> nmcli connection up '$conn'"
    timeout "$CMD_TIMEOUT" sudo nmcli connection up "$conn" >> "$TRENDLOG" 2>&1
}

find_usb_path() {
    local d vid pid
    for d in /sys/bus/usb/devices/*/; do
        [ -f "${d}idVendor" ] && [ -f "${d}idProduct" ] || continue
        vid=$(cat "${d}idVendor" 2>/dev/null)
        pid=$(cat "${d}idProduct" 2>/dev/null)
        if [ "$vid" = "$USB_VID" ] && [ "$pid" = "$USB_PID" ]; then
            basename "$d"; return 0
        fi
    done
    return 1
}

usb_rebind_wifi_dongle() {
    local p
    [ -n "$USB_VID" ] && [ -n "$USB_PID" ] || { log "  -> no USB WiFi dongle configured, skipping rebind"; return 1; }
    p=$(find_usb_path) || { log "  -> dongle not found in sysfs, skipping rebind"; return 1; }
    log "  -> USB unbind/rebind $p"
    echo "$p" | sudo tee /sys/bus/usb/drivers/usb/unbind >> "$TRENDLOG" 2>&1
    sleep 4
    echo "$p" | sudo tee /sys/bus/usb/drivers/usb/bind >> "$TRENDLOG" 2>&1
    sleep 12
}

restart_renderer() {
    log "  -> restarting kiosk-renderer.service"
    timeout "$CMD_TIMEOUT" sudo systemctl restart kiosk-renderer.service >> "$TRENDLOG" 2>&1
}

prune_reboots() {
    local ws
    ws=$(( $(now) - REBOOT_WINDOW ))
    awk -v w="$ws" '$1+0 >= w' "$REBOOT_LOG" > "${REBOOT_LOG}.tmp" 2>/dev/null && mv "${REBOOT_LOG}.tmp" "$REBOOT_LOG"
}

reboot_allowed() {
    prune_reboots
    [ "$(wc -l < "$REBOOT_LOG" 2>/dev/null || echo 0)" -lt "$MAX_REBOOTS" ]
}

record_reboot_and_go() {
    now >> "$REBOOT_LOG"
    echo 0 > "$FAILCOUNT_FILE"
    rm -f "$HELD_FILE"
    capture_bundle "pre-reboot"
    # Tell the tamper watchdog this reboot was watchdog-initiated, not an
    # unexplained restart -- see watchdogs/tamper-watchdog.sh.template.
    now > "$TAMPER_REBOOT_MARKER" 2>/dev/null
    sudo /sbin/reboot
}

format_duration() {
    local secs="$1" h m
    h=$((secs / 3600))
    m=$(((secs % 3600) / 60))
    if [ "$h" -gt 0 ]; then printf '%dh %dm' "$h" "$m"; else printf '%dm' "$m"; fi
}

log_wifi_scan_summary() {
    local scan_file="$1" reason="$2"
    [ -s "$scan_file" ] || return 0
    if grep -q "^command failed" "$scan_file"; then
        echo "$(ts) [$reason] scan failed: $(head -1 "$scan_file")" >> "$WIFI_SCAN_LOG"
        trim_log "$WIFI_SCAN_LOG" "$SCAN_LOG_TRIM_AT" "$SCAN_LOG_TRIM_TO"
        return 0
    fi
    {
        echo "$(ts) [$reason] nearby networks:"
        awk '
            /^BSS /   { if (bssid) print_row(); bssid=$2; sub(/\(on.*/, "", bssid);
                        associated=($0 ~ /associated/) ? " *ASSOCIATED*" : ""; signal=""; freq=""; ssid="" }
            /signal:/ { signal=$2" "$3 }
            /freq:/   { freq=$2 }
            /SSID:/   { ssid=$0; sub(/^[ \t]*SSID:[ \t]*/, "", ssid) }
            function print_row() {
                printf "    %-19s freq=%-6s signal=%-10s ssid=%s%s\n", bssid, freq, signal, ssid, associated
            }
            END { if (bssid) print_row() }
        ' "$scan_file"
    } >> "$WIFI_SCAN_LOG"
    trim_log "$WIFI_SCAN_LOG" "$SCAN_LOG_TRIM_AT" "$SCAN_LOG_TRIM_TO"
}

capture_bundle() {
    local reason="$1"
    local stamp dir
    stamp=$(date '+%Y%m%d-%H%M%S')
    dir="$INCIDENT_DIR/$stamp-$reason"
    mkdir -p "$dir"

    { echo "captured: $(ts)"; echo "reason: $reason"; echo "eth_if: $ETH_IF"; echo "wifi_if: $WIFI_IF"; } > "$dir/summary.txt"

    ip addr show                                                > "$dir/ip_addr.txt"        2>&1
    ip route show                                               > "$dir/ip_route.txt"       2>&1
    timeout "$CMD_TIMEOUT" nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status > "$dir/nm_status.txt" 2>&1
    timeout "$CMD_TIMEOUT" nmcli connection show                > "$dir/nm_connections.txt" 2>&1
    if [ -n "$WIFI_IF" ]; then
        sudo timeout 8 iw dev "$WIFI_IF" link                   > "$dir/iw_link.txt"        2>&1
        sudo timeout 20 iw dev "$WIFI_IF" scan                  > "$dir/iw_scan.txt"        2>&1
        log_wifi_scan_summary "$dir/iw_scan.txt" "$reason"
        sudo rfkill list                                        > "$dir/rfkill.txt"         2>&1
    fi
    if [ -n "$ETH_IF" ] && command -v ethtool >/dev/null 2>&1; then
        sudo ethtool "$ETH_IF"                                  > "$dir/ethtool.txt"        2>&1
    fi
    timeout 8 lsusb -t                                          > "$dir/usb_tree.txt"       2>&1
    { vcgencmd get_throttled; vcgencmd measure_temp; }          > "$dir/power.txt"          2>&1
    sudo dmesg -T 2>/dev/null | tail -300                       > "$dir/dmesg_tail.txt"     2>&1
    sudo journalctl -u NetworkManager --since "-15 min" --no-pager > "$dir/journal_nm.txt" 2>&1
    sudo journalctl -u kiosk-renderer.service --since "-15 min" --no-pager > "$dir/journal_renderer.txt" 2>&1
    systemctl status kiosk-renderer.service --no-pager          > "$dir/renderer_status.txt" 2>&1
    { free -m; uptime; }                                        > "$dir/system.txt"         2>&1

    log "  -> incident bundle written to $dir"
}

# --- per-interface health check ---
# Returns 0/healthy if this interface has an IP, a reachable gateway, real
# internet reachability, and working DNS. STAGE_<if> records where it failed.
check_iface_health() {
    local ifc="$1" stage_var="$2" gw
    [ -n "$ifc" ] || { eval "$stage_var=absent"; return 1; }
    if ! ip addr show "$ifc" 2>/dev/null | grep -q "inet "; then eval "$stage_var=ip"; return 1; fi
    gw=$(ip route show dev "$ifc" 2>/dev/null | awk '/default/{print $3; exit}')
    if [ -z "$gw" ] || ! ping -I "$ifc" -c 2 -W 3 "$gw" >/dev/null 2>&1; then eval "$stage_var=gateway"; return 1; fi
    if ! ping -I "$ifc" -c 2 -W 4 8.8.8.8 >/dev/null 2>&1; then eval "$stage_var=internet"; return 1; fi
    if ! getent hosts "$DASHBOARD_HOST" >/dev/null 2>&1; then eval "$stage_var=dns"; return 1; fi
    eval "$stage_var=ok"
    return 0
}

trend_line() {
    local eth_health="$1" eth_stage="$2" wifi_health="$3" wifi_stage="$4"
    local temp throttled swap avail rendstate
    temp=$(vcgencmd measure_temp 2>/dev/null | sed 's/temp=//')
    throttled=$(vcgencmd get_throttled 2>/dev/null | sed 's/throttled=//')
    swap=$(free -m | awk 'NR==3{print $3}')
    avail=$(free -m | awk 'NR==2{print $7}')
    rendstate=$(systemctl is-active kiosk-renderer.service 2>/dev/null)
    printf '%s eth=%s(%s) wifi=%s(%s) temp=%-8s throttled=%-10s ram_avail=%sMB swap=%sMB renderer=%s\n' \
        "$(ts)" "${ETH_IF:-none}:$eth_health" "$eth_stage" "${WIFI_IF:-none}:$wifi_health" "$wifi_stage" \
        "${temp:-NA}" "${throttled:-NA}" "${avail:-NA}" "${swap:-NA}" "${rendstate:-NA}" \
        >> "$TRENDLOG"
}

# ===================== main =====================
trim_log
cleanup_old_incidents

ETH_IF=$(discover_eth_if)
WIFI_IF=$(discover_wifi_if)

ETH_STAGE="absent"; WIFI_STAGE="absent"
ETH_OK=1; WIFI_OK=1
if [ -n "$ETH_IF" ]; then check_iface_health "$ETH_IF" ETH_STAGE; ETH_OK=$?; fi
if [ -n "$WIFI_IF" ] && wifi_has_profile "$WIFI_IF"; then check_iface_health "$WIFI_IF" WIFI_STAGE; WIFI_OK=$?; fi

ETH_HEALTHY="down"; [ "$ETH_OK" -eq 0 ] && ETH_HEALTHY="ok"
WIFI_HEALTHY="down"; [ "$WIFI_OK" -eq 0 ] && WIFI_HEALTHY="ok"

trend_line "$ETH_HEALTHY" "$ETH_STAGE" "$WIFI_HEALTHY" "$WIFI_STAGE"

# Online if ANY relevant interface is healthy -- this is the whole point of
# the dual-network rewrite: a device that's fine on Ethernet with a flaky,
# unused WiFi radio must not be dragged into reboot escalation over WiFi.
ANY_OK=1
[ "$ETH_HEALTHY" = "ok" ] && ANY_OK=0
[ "$WIFI_HEALTHY" = "ok" ] && ANY_OK=0

if [ "$ANY_OK" -eq 0 ]; then
    PREV=$(cat "$LASTSTATE_FILE" 2>/dev/null)
    if [ "$PREV" != "ok" ]; then
        log "RECOVERED: online again (was: ${PREV:-unknown})."
        if [ -f "$STATE_DIR/alert-since" ]; then
            DOWN_SECS=$(( $(now) - $(cat "$STATE_DIR/alert-since" 2>/dev/null || echo "$(now)") ))
            alert "RESOLVED: recovered after $(format_duration "$DOWN_SECS") of persistent failure (had exhausted reboot budget)."
            rm -f "$STATE_DIR/alert-since"
        fi
        capture_bundle "recovered"
        now > "$LASTHEARTBEAT_FILE"
    elif [ "$(age_of "$LASTHEARTBEAT_FILE")" -ge "$HEARTBEAT_GAP" ]; then
        log "HEARTBEAT: online. up $(uptime -p)."
        now > "$LASTHEARTBEAT_FILE"
    fi
    echo ok > "$LASTSTATE_FILE"
    echo 0 > "$FAILCOUNT_FILE"
    rm -f "$HELD_FILE"
    exit 0
fi

# --- nothing is healthy: escalate ---
FAILCOUNT=$(cat "$FAILCOUNT_FILE" 2>/dev/null)
case "$FAILCOUNT" in ''|*[!0-9]*) FAILCOUNT=0 ;; esac
FAILCOUNT=$((FAILCOUNT + 1))
echo "$FAILCOUNT" > "$FAILCOUNT_FILE"
echo "down" > "$LASTSTATE_FILE"

log "WARN: no healthy network path (eth=$ETH_STAGE, wifi=$WIFI_STAGE), fail #$FAILCOUNT, mode=$MODE"

if [ "$FAILCOUNT" -eq 1 ]; then
    capture_bundle "onset"
fi

# NOTE: this used to be a `case "$FAILCOUNT" in 1) ... 4) ... 24|32|40|48)
# ... *) ...` statement. A `case` only matches the exact listed values --
# every FAILCOUNT that ISN'T one of {1,4,8,12,16,24,32,40,48} (i.e. almost
# every value, including 2 and 3) fell through to the `*)` arm, which
# contained the SAME reboot logic as the intended "last resort" tiers. In
# practice this meant the graduated ladder never ran past LEVER1: fail #1
# triggered a reconnect attempt, and fail #2 (the very next 30s tick)
# immediately rebooted -- confirmed live on the bench (100.64.45.14) via
# the trend log: fail #1 at 11:35:31 -> LEVER1, fail #2 at 11:36:02 ->
# LEVER6 reboot, then the same thing again after the reboot (fail #1 ->
# LEVER1, fail #2 -> LEVER6) at 11:37:35 -- two reboots about 93s apart,
# matching a real user report of "restarted twice in two minutes" after
# disconnecting the internet for a test. Rewritten as if/elif so each
# lever fires exactly once at its milestone and NOTHING happens on the
# FAILCOUNT values in between -- the ladder now actually reaches reboot
# only at fail #24 (~12 minutes of total dual-interface failure after
# already trying reconnect, NM restart, force reconnect, USB rebind, and a
# renderer restart), matching what the comments and MAX_REBOOTS/"last
# resort" framing always intended.
if [ "$FAILCOUNT" -eq 1 ]; then
    log "LEVER1: reconnect (both interfaces)"
    if [ "$MODE" = "active" ]; then
        [ -n "$ETH_IF" ] && bring_up "$(get_conn_name_eth)"
        [ -n "$WIFI_IF" ] && bring_up "$(get_conn_name_wifi)"
    fi
    sleep 8
elif [ "$FAILCOUNT" -eq 4 ]; then
    if [ "$(age_of "$NMRESTART_FILE")" -lt "$NM_RESTART_MIN_GAP" ]; then
        log "LEVER2: NM restart suppressed (rate-limited), retrying reconnect"
    else
        log "LEVER2: restarting NetworkManager"
        now > "$NMRESTART_FILE"
        if [ "$MODE" = "active" ]; then
            timeout "$CMD_TIMEOUT" sudo systemctl restart NetworkManager >> "$TRENDLOG" 2>&1
            sleep 20
        fi
    fi
    if [ "$MODE" = "active" ]; then
        [ -n "$ETH_IF" ] && bring_up "$(get_conn_name_eth)"
        [ -n "$WIFI_IF" ] && bring_up "$(get_conn_name_wifi)"
    fi
    sleep 10
elif [ "$FAILCOUNT" -eq 8 ]; then
    log "LEVER3: force disconnect + fresh DHCP (both interfaces)"
    if [ "$MODE" = "active" ]; then
        [ -n "$ETH_IF" ] && timeout "$CMD_TIMEOUT" sudo nmcli device disconnect "$ETH_IF" >> "$TRENDLOG" 2>&1
        [ -n "$WIFI_IF" ] && timeout "$CMD_TIMEOUT" sudo nmcli device disconnect "$WIFI_IF" >> "$TRENDLOG" 2>&1
        sleep 5
        [ -n "$ETH_IF" ] && bring_up "$(get_conn_name_eth)"
        [ -n "$WIFI_IF" ] && bring_up "$(get_conn_name_wifi)"
    fi
    sleep 15
elif [ "$FAILCOUNT" -eq 12 ]; then
    log "LEVER4: WiFi USB rebind (if applicable) -- no equivalent action for Ethernet"
    if [ "$MODE" = "active" ] && [ -n "$WIFI_IF" ]; then
        usb_rebind_wifi_dongle && bring_up "$(get_conn_name_wifi)"
    fi
    sleep 15
elif [ "$FAILCOUNT" -eq 16 ]; then
    log "LEVER5: renderer restart"
    [ "$MODE" = "active" ] && restart_renderer
elif [ "$FAILCOUNT" -ge 24 ]; then
    if [ "$((FAILCOUNT % 8))" -eq 0 ]; then
        capture_bundle "escalation-fail$FAILCOUNT"
    fi
    if [ "$MODE" != "active" ]; then
        log "LEVER6: WOULD consider reboot (observe mode). fail #$FAILCOUNT"
    elif reboot_allowed; then
        log "LEVER6: rebooting as last resort (budget $(wc -l < "$REBOOT_LOG")/$MAX_REBOOTS in ${REBOOT_WINDOW}s)"
        alert "LEVER6: rebooting as last resort at fail #$FAILCOUNT (eth=$ETH_STAGE, wifi=$WIFI_STAGE)."
        record_reboot_and_go
    else
        if [ ! -f "$HELD_FILE" ]; then
            log "HELD: reboot budget exhausted. Likely AP-side/RF/hardware/upstream -- escalate with these logs."
            alert "HELD: reboot budget exhausted at fail #$FAILCOUNT (eth=$ETH_STAGE, wifi=$WIFI_STAGE). See $WIFI_SCAN_LOG for nearby-network signal data."
            now > "$STATE_DIR/alert-since"
            touch "$HELD_FILE"
        fi
    fi
else
    : # between levers -- nothing new to do this cycle, just keep retrying the health check
fi

ETH_OK=1; WIFI_OK=1
if [ -n "$ETH_IF" ]; then check_iface_health "$ETH_IF" ETH_STAGE; ETH_OK=$?; fi
if [ -n "$WIFI_IF" ] && wifi_has_profile "$WIFI_IF"; then check_iface_health "$WIFI_IF" WIFI_STAGE; WIFI_OK=$?; fi
if [ "$ETH_OK" -eq 0 ] || [ "$WIFI_OK" -eq 0 ]; then
    log "RECOVERED: online after fail #$FAILCOUNT intervention."
    if [ -f "$STATE_DIR/alert-since" ]; then
        DOWN_SECS=$(( $(now) - $(cat "$STATE_DIR/alert-since" 2>/dev/null || echo "$(now)") ))
        alert "RESOLVED: recovered after $(format_duration "$DOWN_SECS") of persistent failure (had exhausted reboot budget)."
        rm -f "$STATE_DIR/alert-since"
    fi
    capture_bundle "recovered"
    echo ok > "$LASTSTATE_FILE"
    echo 0 > "$FAILCOUNT_FILE"
    rm -f "$HELD_FILE"
    now > "$LASTHEARTBEAT_FILE"
else
    log "STILL DOWN after fail #$FAILCOUNT (eth=$ETH_STAGE, wifi=$WIFI_STAGE)."
fi
