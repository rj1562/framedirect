#!/bin/bash
# Generated by the architect2 kiosk installer -- __INSTALL_DATE__
#
# Ported unchanged from versions/v9/pi-cec-watchdog.sh.template. This logic
# talks to the CEC adapter directly and has no dependency on Chromium, X11,
# or any compositor -- it works identically whether the display is being
# driven by Chromium (v9) or the native renderer (architect2), so it did
# not need to change for this rewrite.
#
# HDMI-CEC display watchdog. Wakes the TV from standby and keeps it on
# this Pi's HDMI input, correcting it back if something (a remote, the
# TV's own smart-TV platform, a power blip) switches it away.
#
# Bench-validated on a real TV (TCL, 2026-09-21) before being written
# this way -- every mechanism below was tested live, not assumed:
#   - Power status query: reliable, real replies in 13-268ms.
#   - Image View On (wake): reliably wakes the TV from standby.
#   - Active Source broadcast: reliably corrects the TV back to this
#     Pi's HDMI input when it was showing something else (confirmed:
#     TV was manually left on its home screen, this command switched
#     it back to HDMI).
#   - Request Active Source (asking the TV "who's currently active"):
#     UNRELIABLE -- timed out with no reply even while the TV was
#     already confirmed on the correct input. Not used to gate any
#     decision; only logged best-effort for visibility.
#
# DESIGN CHOICE, not an oversight: because querying "are we already the
# active source" can't be trusted, this does not try to detect wrong
# state before correcting it. Instead, every cycle where the TV is
# confirmed on, it unconditionally re-asserts Active Source. Re-asserting
# when already correct is normal, harmless CEC behavior (real devices do
# this after any state change) -- this sidesteps the unreliable query
# entirely rather than building logic on top of a signal proven flaky on
# real hardware.
#
# NOT YET VALIDATED: behavior on a Xiaomi TV (the actual client
# hardware) -- everything above used only standard CEC opcodes, not
# brand-specific extensions, so it should behave the same, but CEC
# compliance is well documented as varying by brand/model. Treat this as
# proven on TCL, not yet proven on Xiaomi, until it's actually been run
# against one.

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/bin:/usr/bin"

CEC_DEVICE="/dev/cec0"
CMD_TIMEOUT=8

STATE_DIR="/var/lib/pi-cec-watchdog"
TRENDLOG="/var/log/pi-cec-watchdog.log"
ALERTS_LOG="/var/log/pi-cec-watchdog-alerts.log"
LAST_POWER_STATE_FILE="$STATE_DIR/last-power-state"
NO_REPLY_COUNT_FILE="$STATE_DIR/no-reply-count"
NOT_CEC_MARKER="$STATE_DIR/classified-not-cec-capable"
TREND_TRIM_AT=20000
TREND_TRIM_TO=15000
ALERTS_TRIM_AT=2000
ALERTS_TRIM_TO=1500

# This fleet deploys to both real TVs (CEC-capable) and plain monitors (no
# CEC at all) -- explicit direction: detect which one a device has, rather
# than silently repeating the same WARN every 30s forever on a monitor.
# After this many consecutive cycles with no meaningful CEC reply from the
# far end, classify the display as not CEC-capable and stop hammering it
# every cycle -- re-check only occasionally after that, in case a monitor
# gets swapped for a real TV later.
NO_REPLY_THRESHOLD=5
RECHECK_EVERY_N_CYCLES=20

sudo mkdir -p "$STATE_DIR"
sudo chown pi:pi "$STATE_DIR"
sudo touch "$TRENDLOG" "$ALERTS_LOG"
sudo chown pi:pi "$TRENDLOG" "$ALERTS_LOG"

ts() { date '+%Y-%m-%d %H:%M:%S'; }
log() { echo "$(ts) $1" >> "$TRENDLOG"; }
alert() { echo "$(ts) $1" >> "$ALERTS_LOG"; }

trim_log() {
    local file="$1" trim_at="$2" trim_to="$3" n trimmed
    [ -f "$file" ] || return 0
    n=$(wc -l < "$file")
    if [ "$n" -gt "$trim_at" ]; then
        trimmed=$(tail -n "$trim_to" "$file")
        printf '%s\n' "$trimmed" > "$file"
    fi
}

# --- Display power safeguard (architect2 addition, separate from CEC) ---
# Real symptom reported on the bench (2026-09-22): the renderer was
# confirmed alive and healthy (still fetching fresh data every cycle,
# never crashed) but the physical display had gone black after being idle
# for a while. `vcgencmd display_power` (the Pi's own HDMI transmitter
# power state -- a DIFFERENT mechanism from CEC, which only talks to an
# external TV) reported "on" throughout, and a legacy fbdev "blank" flag
# stayed stuck even across a full renderer restart -- inconclusive as to
# the exact mechanism, but not worth chasing further given the standard,
# low-risk fix: don't try to detect "is the display already awake",
# unconditionally re-assert it awake every cycle, every device, whether or
# not it even has CEC -- same idiom already proven for Active Source below.
vcgencmd display_power 1 >> "$TRENDLOG" 2>&1

# --- Step 0: does a CEC adapter exist at all on this board/cable/TV? ---
if [ ! -e "$CEC_DEVICE" ]; then
    log "SKIP: $CEC_DEVICE does not exist -- no CEC adapter detected"
    exit 0
fi
if ! command -v cec-ctl >/dev/null 2>&1; then
    log "SKIP: cec-ctl not installed"
    exit 0
fi

# --- Already classified as a non-CEC display? Don't hammer it every cycle. ---
if [ -f "$NOT_CEC_MARKER" ]; then
    CYCLE=$(( $(cat "$STATE_DIR/cycle-count" 2>/dev/null || echo 0) + 1 ))
    echo "$CYCLE" > "$STATE_DIR/cycle-count"
    if [ "$((CYCLE % RECHECK_EVERY_N_CYCLES))" -ne 0 ]; then
        log "SKIP: display previously classified not CEC-capable -- rechecking every $RECHECK_EVERY_N_CYCLES cycles, not every cycle"
        trim_log "$TRENDLOG" "$TREND_TRIM_AT" "$TREND_TRIM_TO"
        exit 0
    fi
    log "INFO: periodic recheck of a previously-not-CEC-capable display"
fi

# --- Step 1: (re-)claim a logical address on the CEC bus ---
# Bench-confirmed: without this, every query below fails with "Adapter
# is unconfigured". Also bench-confirmed (via bash -x tracing a real
# failure): a genuinely fresh/never-configured adapter shows
# "Logical Addresses: 0" with NO "Not Allocated" text anywhere -- that
# string only appears in a DIFFERENT, partially-configured state (role
# requested but address not yet granted). An earlier version of this
# script only checked for "Not Allocated" and missed the fresh-adapter
# case entirely, causing every query to silently fail with "unknown"
# state. Also confirmed: the logical address claim does not persist
# between separate process invocations -- each oneshot run of this
# script starts genuinely unconfigured, every time, regardless of what
# the previous run did.
#
# Fix: stop trying to detect which of the two "not ready" states this
# is. Unconditionally (re-)request the playback role every cycle,
# before anything else -- same idempotent pattern already proven safe
# for the Active Source assertion below (harmless if already done,
# fixes it if not), rather than depending on parsing cec-ctl's text
# output to decide whether to act.
timeout "$CMD_TIMEOUT" cec-ctl --playback -S >> "$TRENDLOG" 2>&1
LA_STATE=$(timeout "$CMD_TIMEOUT" cec-ctl -l 2>&1)

note_no_reply() {
    local n
    n=$(( $(cat "$NO_REPLY_COUNT_FILE" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$NO_REPLY_COUNT_FILE"
    if [ "$n" -ge "$NO_REPLY_THRESHOLD" ] && [ ! -f "$NOT_CEC_MARKER" ]; then
        touch "$NOT_CEC_MARKER"
        echo 0 > "$STATE_DIR/cycle-count"
        alert "CLASSIFIED: this display is not responding to CEC after $n consecutive attempts -- most likely a plain monitor without CEC support (expected on non-TV deployments), or a CEC-capable TV with CEC disabled in its own settings. No CEC wake/input-correction will happen on this device; the separate vcgencmd display-power safeguard above still applies regardless."
        log "CLASSIFIED: not CEC-capable (or CEC disabled) -- switching to periodic recheck every $RECHECK_EVERY_N_CYCLES cycles"
    fi
}

note_reply_ok() {
    if [ -f "$NOT_CEC_MARKER" ]; then
        alert "RECOVERED: display is now responding to CEC again (was classified not-CEC-capable)"
        rm -f "$NOT_CEC_MARKER" "$STATE_DIR/cycle-count"
    fi
    echo 0 > "$NO_REPLY_COUNT_FILE"
}

# --- Step 2: power status -- the one reliably-queryable signal ---
POWER_RAW=$(timeout "$CMD_TIMEOUT" cec-ctl --to 0 --give-device-power-status 2>&1)
RC=$?
if [ "$RC" -ne 0 ]; then
    log "WARN: power-status query failed or timed out (rc=$RC) -- TV may be disconnected/powered off at the wall"
    note_no_reply
    trim_log "$TRENDLOG" "$TREND_TRIM_AT" "$TREND_TRIM_TO"
    exit 0
fi

PREV_STATE=$(cat "$LAST_POWER_STATE_FILE" 2>/dev/null || echo "unknown")

if printf '%s' "$POWER_RAW" | grep -q "pwr-state: on"; then
    CURRENT_STATE="on"
elif printf '%s' "$POWER_RAW" | grep -q "pwr-state: standby"; then
    CURRENT_STATE="standby"
else
    CURRENT_STATE="unknown"
fi

if [ "$CURRENT_STATE" != "$PREV_STATE" ]; then
    if [ "$PREV_STATE" = "standby" ] && [ "$CURRENT_STATE" = "on" ]; then
        alert "RECOVERED: TV came back on from standby"
    elif [ "$CURRENT_STATE" = "standby" ]; then
        alert "TV is in standby -- sending wake command"
    fi
    echo "$CURRENT_STATE" > "$LAST_POWER_STATE_FILE"
fi

log "STATE: $CURRENT_STATE"

if [ "$CURRENT_STATE" = "standby" ]; then
    # Standby is still a real, meaningful reply from the far end (unlike
    # "unknown") -- it proves this display DOES support CEC, so it counts
    # toward reply_ok, not toward the not-CEC-capable classification.
    note_reply_ok
    timeout "$CMD_TIMEOUT" cec-ctl --to 0 --image-view-on >> "$TRENDLOG" 2>&1
    log "ACTION: sent wake command (Image View On)"
    trim_log "$TRENDLOG" "$TREND_TRIM_AT" "$TREND_TRIM_TO"
    trim_log "$ALERTS_LOG" "$ALERTS_TRIM_AT" "$ALERTS_TRIM_TO"
    exit 0
fi

if [ "$CURRENT_STATE" != "on" ]; then
    log "WARN: power status query returned an unrecognized reply -- not acting this cycle"
    note_no_reply
    trim_log "$TRENDLOG" "$TREND_TRIM_AT" "$TREND_TRIM_TO"
    exit 0
fi

note_reply_ok

# --- Step 3: TV is on -- best-effort probe of current source, logged
# only, never used to decide anything (see header: proven unreliable) ---
PROBE=$(timeout "$CMD_TIMEOUT" cec-ctl --to 0 --request-active-source 2>&1)
if printf '%s' "$PROBE" | grep -q "Timeout"; then
    log "INFO: active-source probe got no reply (known-unreliable on this hardware, not acted on)"
else
    log "INFO: active-source probe: $(printf '%s' "$PROBE" | grep -i "phys-addr" | head -1)"
fi

# --- Step 4: unconditionally assert this Pi as the active source ---
# Reliable and proven on real hardware (see header). Harmless if the TV
# is already on this input; corrects it if it isn't.
OUR_PHYS_ADDR=$(printf '%s' "$LA_STATE" | grep -oE "Physical Address[[:space:]]*: [0-9a-f.]+" | grep -oE "[0-9a-f.]+$" | head -1)
if [ -n "$OUR_PHYS_ADDR" ] && [ "$OUR_PHYS_ADDR" != "f.f.f.f" ]; then
    timeout "$CMD_TIMEOUT" cec-ctl --active-source "phys-addr=$OUR_PHYS_ADDR" >> "$TRENDLOG" 2>&1
    log "ACTION: asserted active source (phys-addr=$OUR_PHYS_ADDR)"
else
    log "WARN: no valid physical address yet -- skipping active-source assertion this cycle"
fi

trim_log "$TRENDLOG" "$TREND_TRIM_AT" "$TREND_TRIM_TO"
trim_log "$ALERTS_LOG" "$ALERTS_TRIM_AT" "$ALERTS_TRIM_TO"
