#!/bin/bash
# Generated by the architect2 kiosk installer -- __INSTALL_DATE__
#
# Dedicated "nearby WiFi behaviour" log, run on its own schedule independent
# of net-watchdog's incident-triggered scans. Per instruction: only relevant
# when this device actually uses WiFi -- on an Ethernet-only device this
# self-disables (logs once, exits, and stays out of the way rather than
# running a pointless scan every cycle).

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/bin:/usr/bin"

WIFI_SCAN_LOG="/var/log/kiosk-wifi-scan.log"
STATE_DIR="/var/lib/kiosk-wifi-scan-watchdog"
DISABLED_MARKER="$STATE_DIR/disabled-no-wifi"
SCAN_LOG_TRIM_AT=4000
SCAN_LOG_TRIM_TO=3000
CMD_TIMEOUT=25

sudo mkdir -p "$STATE_DIR"
sudo chown pi:pi "$STATE_DIR"
sudo touch "$WIFI_SCAN_LOG"
sudo chown pi:pi "$WIFI_SCAN_LOG"

ts() { date '+%Y-%m-%d %H:%M:%S'; }

trim_log() {
    local file="$1" trim_at="$2" trim_to="$3" n trimmed
    [ -f "$file" ] || return 0
    n=$(wc -l < "$file")
    if [ "$n" -gt "$trim_at" ]; then
        trimmed=$(tail -n "$trim_to" "$file")
        printf '%s\n' "$trimmed" > "$file"
    fi
}

WIFI_IF=$(timeout "$CMD_TIMEOUT" nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')
HAS_WIFI_PROFILE=$(timeout "$CMD_TIMEOUT" nmcli -t -f NAME,TYPE connection show 2>/dev/null | awk -F: '$2=="802-11-wireless" || $2=="wifi"{print "yes"; exit}')

if [ -z "$WIFI_IF" ] || [ -z "$HAS_WIFI_PROFILE" ]; then
    if [ ! -f "$DISABLED_MARKER" ]; then
        echo "$(ts) DISABLED: no WiFi interface/profile in use on this device -- this log will stay empty (Ethernet-only device)" >> "$WIFI_SCAN_LOG"
        touch "$DISABLED_MARKER"
    fi
    exit 0
fi
rm -f "$DISABLED_MARKER"

SCAN_OUT=$(sudo timeout 20 iw dev "$WIFI_IF" scan 2>&1)
if [ $? -ne 0 ]; then
    echo "$(ts) scan failed: $(printf '%s' "$SCAN_OUT" | head -1)" >> "$WIFI_SCAN_LOG"
    trim_log "$WIFI_SCAN_LOG" "$SCAN_LOG_TRIM_AT" "$SCAN_LOG_TRIM_TO"
    exit 0
fi

{
    echo "$(ts) [routine] nearby networks:"
    printf '%s' "$SCAN_OUT" | awk '
        /^BSS /   { if (bssid) print_row(); bssid=$2; sub(/\(on.*/, "", bssid);
                    associated=($0 ~ /associated/) ? " *ASSOCIATED*" : ""; signal=""; freq=""; ssid="" }
        /signal:/ { signal=$2" "$3 }
        /freq:/   { freq=$2 }
        /SSID:/   { ssid=$0; sub(/^[ \t]*SSID:[ \t]*/, "", ssid) }
        function print_row() {
            printf "    %-19s freq=%-6s signal=%-10s ssid=%s%s\n", bssid, freq, signal, ssid, associated
        }
        END { if (bssid) print_row() }
    '
} >> "$WIFI_SCAN_LOG"
trim_log "$WIFI_SCAN_LOG" "$SCAN_LOG_TRIM_AT" "$SCAN_LOG_TRIM_TO"
