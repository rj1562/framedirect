#!/bin/bash
# Generated by the architect2 kiosk installer -- __INSTALL_DATE__
#
# Boot/restart history log. Runs once per boot (not on a repeating timer --
# there's nothing new to check between boots).
#
# HONEST LIMITATION: this Pi has no dedicated tamper hardware (no case-open
# switch, no accelerometer, no battery-backed RTC to detect a clock jump
# from a pulled battery). What this CAN do with software alone is
# distinguish three things:
#   1. WATCHDOG_REBOOT  -- net-watchdog issued this reboot itself (it leaves
#      a marker file right before calling `reboot`).
#   2. CLEAN_SHUTDOWN   -- the previous session ended with a normal shutdown/
#      reboot sequence in the log (someone ran `sudo reboot`/`shutdown`, or
#      a graceful systemd shutdown happened).
#   3. UNEXPECTED       -- the previous session just stops with no shutdown
#      record at all -- consistent with a power loss, a yanked cable, or
#      someone cutting power at the wall. It is NOT proof of tampering,
#      just an unexplained restart worth a human looking at the timeline.
#
# This is a real, useful signal (an unattended kiosk suddenly showing a run
# of UNEXPECTED entries is worth investigating) but it should not be
# oversold as tamper *detection* in the physical-security sense.

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/bin:/usr/bin"

TAMPER_LOG="/var/log/kiosk-tamper.log"
STATE_DIR="/var/lib/kiosk-tamper"
REBOOT_MARKER="$STATE_DIR/expected-reboot"
LAST_BOOT_ID_FILE="$STATE_DIR/last-boot-id"
TRIM_AT=5000
TRIM_TO=4000

sudo mkdir -p "$STATE_DIR"
sudo chown pi:pi "$STATE_DIR"
sudo touch "$TAMPER_LOG"
sudo chown pi:pi "$TAMPER_LOG"

ts() { date '+%Y-%m-%d %H:%M:%S'; }
log() { echo "$(ts) $1" >> "$TAMPER_LOG"; }

trim_log() {
    [ -f "$TAMPER_LOG" ] || return 0
    local n
    n=$(wc -l < "$TAMPER_LOG")
    if [ "$n" -gt "$TRIM_AT" ]; then
        tail -n "$TRIM_TO" "$TAMPER_LOG" > "${TAMPER_LOG}.tmp" && mv "${TAMPER_LOG}.tmp" "$TAMPER_LOG"
    fi
}

CURRENT_BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
PREV_BOOT_ID=$(cat "$LAST_BOOT_ID_FILE" 2>/dev/null || echo "")

if [ "$CURRENT_BOOT_ID" = "$PREV_BOOT_ID" ]; then
    # This service already ran for this boot (e.g. manually re-triggered);
    # don't log a duplicate entry.
    exit 0
fi
echo "$CURRENT_BOOT_ID" > "$LAST_BOOT_ID_FILE"

BOOT_TIME=$(who -b 2>/dev/null | awk '{print $3, $4}')
UPTIME_NOW=$(uptime -p 2>/dev/null)

if [ -f "$REBOOT_MARKER" ]; then
    MARKER_AGE=$(( $(date +%s) - $(cat "$REBOOT_MARKER" 2>/dev/null || echo 0) ))
    rm -f "$REBOOT_MARKER"
    if [ "$MARKER_AGE" -lt 900 ]; then
        log "BOOT: classification=WATCHDOG_REBOOT boot_time='$BOOT_TIME' ($UPTIME_NOW) -- net-watchdog reboot marker was ${MARKER_AGE}s old"
        trim_log
        exit 0
    fi
    log "NOTE: found a stale watchdog-reboot marker (${MARKER_AGE}s old, ignored as too old to trust)"
fi

# No fresh watchdog marker -- was the previous session's end graceful?
# `last -x` records a "shutdown"/"reboot" pseudo-user line for a clean
# shutdown sequence; its absence right before this boot's own reboot line
# is the signal for an abrupt cut.
PREV_END_LINE=$(last -x -F 2>/dev/null | awk '/^(shutdown|reboot) /{print; exit}')

if printf '%s' "$PREV_END_LINE" | grep -q '^shutdown '; then
    log "BOOT: classification=CLEAN_SHUTDOWN boot_time='$BOOT_TIME' ($UPTIME_NOW) -- prev session ended with: $PREV_END_LINE"
else
    log "BOOT: classification=UNEXPECTED boot_time='$BOOT_TIME' ($UPTIME_NOW) -- no clean shutdown record found before this boot (consistent with power loss / cable pulled / power cut at the wall; not proof of physical tampering)"
fi

trim_log
